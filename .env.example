# Необязательно: без .env приложение само создаёт секрет в instance/.secret_key.
# Для своего ключа: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=вставьте_свой_случайный_ключ_длиной_не_менее_32_символов

# Для локального HTTP оставьте 0. Для размещения через HTTPS установите 1.
COOKIE_SECURE=0
HOST=127.0.0.1
PORT=5000
